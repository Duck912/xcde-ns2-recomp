{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xcde-launcher",
  "version": "0.1.1",
  "identifier": "io.github.duck912.xcde-ns2-recomp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "XC:DE NS2 recomp launcher",
        "width": 980,
        "height": 660,
        "minWidth": 860,
        "decorations": false,
        "transparent": true,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; media-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
